{
  "name": "mailcow-mobile",
  "slug": "mailcow-mobile",
  "version": "0.0.1",
  "orientation": "portrait",
  "icon": "./assets/images/icon.png",
  "scheme": "mailcowmobile",
  "userInterfaceStyle": "automatic",
  "newArchEnabled": true,
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "org.jaws.mailcowmobile"
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/images/adaptive-icon.png",
      "backgroundColor": "#0D1B2A"
    },
    "package": "org.jaws.mailcowmobile"
  },
  "web": {
    "bundler": "metro",
    "output": "static",
    "favicon": "./assets/images/favicon.png"
  },
  "plugins": [
    "expo-router",
    "expo-secure-store",
    [
      "expo-notifications",
      {
        "icon": "./assets/images/notification-icon.png",
        "color": "#2563EB"
      }
    ]
  ],
  "experiments": {
    "typedRoutes": true
  }
}
